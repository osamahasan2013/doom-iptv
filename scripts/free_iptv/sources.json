{
  "_note": "Only open, maintained sources of free / publicly available live channels. Each link is checked daily; a link that fails on 2 checks in a row is removed automatically.",
  "strikes_to_remove": 2,
  "check_timeout": 10,
  "workers": 48,
  "source_grace_days": 3,
  "sources": [
    {
      "id": "iptv-org",
      "name": "iptv-org (publicly available channels)",
      "home": "https://github.com/iptv-org/iptv",
      "kind": "iptv-org-api",
      "base": "https://iptv-org.github.io/api/",
      "enabled": true
    },
    {
      "id": "free-tv",
      "name": "Free-TV/IPTV (free-to-air channels)",
      "home": "https://github.com/Free-TV/IPTV",
      "kind": "m3u",
      "url": "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8",
      "enabled": true
    }
  ]
}